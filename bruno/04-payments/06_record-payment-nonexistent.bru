meta {
  name: Payment on nonexistent debt (expect 404)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/debts/99999/payments
  body: json
  auth: bearer
}

body:json {
  {
    "amount": 100
  }
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.status !== 404) throw new Error("Expected 404, got " + res.status);
}