meta {
  name: Delete debt cascade (expect 204)
  type: http
  seq: 12
}

delete {
  url: {{baseUrl}}/api/debts/{{extraDebtId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.status !== 204) throw new Error("Expected 204, got " + res.status);
}