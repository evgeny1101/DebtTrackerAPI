meta {
  name: Register username too short (expect 422)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  X-Forwarded-For: 203.0.113.10
}

body:json {
  {
    "username": "a",
    "password": "secret123"
  }
}

script:post-response {
  if (res.status !== 422) throw new Error("Expected 422, got " + res.status);
}