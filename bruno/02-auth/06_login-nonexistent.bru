meta {
  name: Login nonexistent user (expect 401)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  X-Forwarded-For: 203.0.113.10
}

body:json {
  {
    "username": "ghost",
    "password": "secret123"
  }
}

script:post-response {
  if (res.status !== 401) throw new Error("Expected 401, got " + res.status);
}