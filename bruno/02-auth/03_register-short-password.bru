meta {
  name: Register password too short (expect 422)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  X-Forwarded-For: 203.0.113.10
}

body:json {
  {
    "username": "carol",
    "password": "12345"
  }
}

script:post-response {
  if (res.status !== 422) throw new Error("Expected 422, got " + res.status);
}