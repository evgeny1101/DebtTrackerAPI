meta {
  name: Logout (expect 204)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/auth/logout
  body: json
  auth: bearer
}

headers {
  X-Forwarded-For: 203.0.113.10
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.status !== 204) throw new Error("Expected 204, got " + res.status);
}