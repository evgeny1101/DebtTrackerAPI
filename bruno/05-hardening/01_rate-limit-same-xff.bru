meta {
  name: Rate limit — same XFF x6 (expect 429)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  X-Forwarded-For: 203.0.113.10
}

body:json {
  {
    "username": "alice",
    "password": "wrongpass"
  }
}

script:post-response {
  // Run this request 6 times quickly — the 6th should be 429.
  if (res.status === 429) {
    bru.setEnvVar("rateLimited", "yes");
  } else if (res.status !== 401) {
    throw new Error("Unexpected status: " + res.status);
  }
}